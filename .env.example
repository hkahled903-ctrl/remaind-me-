# The keys this project reads, and nothing else. Real values live in Infisical's
# `dev` environment and reach the process as environment variables, so this file
# is a list of names -- it is safe to commit and safe to read.
#
# Nothing loads a `.env` file. A filled-in copy of this file changes nothing on
# its own, which is the point: there is no copy left to drift.
#
# Get the values into the process with the Infisical CLI:
#   infisical login
#   infisical init
#   infisical run --env=dev -- python -m reminder --dry-run
#
# In CI the same values arrive through a machine identity using Universal Auth;
# the README section "Secrets live in Infisical" has the details.

# --- Telegram ---------------------------------------------------------------
# From @BotFather. A password: never commit it, never print it into a chat.
TELEGRAM_BOT_TOKEN=

# --- Connect page (optional) -----------------------------------------------
# Required by `--serve`; it refuses to start without one, because an
# unauthenticated webhook would let a stranger redirect your reminder.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# The public https URL of the deployed host. Without it the page runs but
# Telegram cannot deliver `/start` updates to it.
PUBLIC_URL=

# Optional. Discovered from the token via getMe if omitted; set it to save a call.
BOT_USERNAME=

# --- Binding store (optional) ----------------------------------------------
# Set BOTH to keep the connected chat in Upstash instead of a local file. Do this
# on a host whose disk does not survive a redeploy, and where the 09:00 GitHub
# Actions run must be able to read the same chat id.
#
# Not optional for interval mode. On a CI runner the file is written and thrown
# away, so every */5 heartbeat looks like a fresh period and sends again: 288
# messages a day. `--interval` refuses to send in that situation.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Escape hatch for interval mode on a host with a genuinely durable disk that
# does not set a recognised CI variable. Leave unset unless `--interval` refuses
# to run on a machine you know keeps its files.
REMINDER_ALLOW_FILE_INTERVAL=

# --- Archil (separate, unrelated to the reminder) --------------------------
# Get an API key from the Archil console: https://console.archil.com
ARCHIL_API_KEY=key-...

# Serverless exec is AWS-only today. One of:
# aws-us-east-1 | aws-us-west-2 | aws-eu-west-1
ARCHIL_REGION=aws-us-east-1